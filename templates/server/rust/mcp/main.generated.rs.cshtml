/// Translate a logic-layer error into an MCP tool error. Unauthorized maps to
/// invalid_request (closest MCP has to the REST API's 403), a domain Event
/// error (e.g. "unknown object") to invalid_params, everything else to
/// internal_error -- same triage as the API server's `error_response`.
fn to_mcp_error(e: LogicError) -> McpError {
    match e {
        LogicError::Unauthorized(m) => McpError::invalid_request(m, None),
        LogicError::Event(m) => McpError::invalid_params(m, None),
        other => {
            Logger::error(format!("mcp error: {}", other));
            McpError::internal_error(other.to_string(), None)
        }
    }
}

/// Resolve the principal a tool call should run as.
///
/// rmcp injects the inbound `http::request::Parts` into the call's
/// `RequestContext::extensions` for the streamable-HTTP/SSE transport only
/// (see the module doc comment at the top of this file); stdio calls carry no
/// such extension at all, since there is no HTTP request to inject.
fn resolve_principal(context: &RequestContext<RoleServer>) -> Result<Option<String>, McpError> {
    match context.extensions.get::<http::request::Parts>() {
        Some(parts) => {
            let auth_header = parts
                .headers
                .get("Authorization")
                .and_then(|v| v.to_str().ok());
            match auth0::authenticate_inbound("mcp", auth_header) {
                auth0::AuthOutcome::Authenticated(user) => Ok(Some(user)),
                // No "mcp" audience configured -- fall back to X-User, exactly
                // like the API server's Auth0-unconfigured path.
                auth0::AuthOutcome::Unconfigured => Ok(parts
                    .headers
                    .get("X-User")
                    .and_then(|v| v.to_str().ok())
                    .map(|s| s.to_string())),
                auth0::AuthOutcome::Missing => {
                    Err(McpError::invalid_request("missing bearer token", None))
                }
                auth0::AuthOutcome::Invalid(reason) => {
                    Logger::warning(format!("MCP JWT validation failed: {}", reason));
                    Err(McpError::invalid_request(
                        format!("invalid bearer token: {}", reason),
                        None,
                    ))
                }
            }
        }
        // stdio: no HTTP request to authenticate -- run as the configured
        // trusted local principal for the whole session. `None` here means
        // the entry is simply absent from ~/.@(Model.Name).json; every tool
        // call then runs with no principal set, and RBAC denies it exactly as
        // it would an anonymous REST call -- this is a configuration gap to
        // fix, not a silent bypass.
        None => Ok(Config::server_principal("mcp")),
    }
}

#[tool_handler(router = self.tool_router)]
impl ServerHandler for McpServer {
    fn get_info(&self) -> McpServerConfig {
        McpServerConfig::new(ServerCapabilities::builder().enable_tools().build())
    }

    /// Overrides the #[tool_handler]-generated `call_tool` (which would skip
    /// authorization entirely) to resolve the calling principal and make it
    /// available to the tool method about to run, via the `Extension`
    /// extractor (every generated/hand-written tool method takes
    /// `Extension<ResolvedPrincipal>`) -- see the module doc comment for why
    /// the principal travels this way instead of a thread-local: the actual
    /// logic-layer call happens on a different OS thread entirely
    /// (`run_on_db_thread`), where a thread-local set here would simply not
    /// be visible.
    async fn call_tool(
        &self,
        request: CallToolRequestParams,
        mut context: RequestContext<RoleServer>,
    ) -> Result<CallToolResponse, McpError> {
        let principal = resolve_principal(&context)?;
        context.extensions.insert(ResolvedPrincipal(principal));
        let tcc = ToolCallContext::new(self, request, context);
        self.tool_router.call(tcc).await
    }
}

#[tokio::main]
async fn main() -> Result<(), Box<dyn std::error::Error>> {
    init_logging();
    match resolve_transport().as_str() {
        "stdio" => run_stdio().await,
        "http" => run_http().await,
        other => {
            Logger::error(format!(
                "unknown --transport '{}': expected 'stdio' or 'http'",
                other
            ));
            std::process::exit(1);
        }
    }
}

/// `--transport stdio|http` (two argv tokens) or the JUMPSTART_MCP_TRANSPORT
/// env var; defaults to "stdio" (the transport an MCP client normally
/// launches this binary with directly).
fn resolve_transport() -> String {
    let args: Vec<String> = std::env::args().collect();
    for i in 0..args.len() {
        if args[i] == "--transport" {
            if let Some(v) = args.get(i + 1) {
                return v.clone();
            }
        }
    }
    std::env::var("JUMPSTART_MCP_TRANSPORT").unwrap_or_else(|_| "stdio".to_string())
}

async fn run_stdio() -> Result<(), Box<dyn std::error::Error>> {
    Logger::info("MCP server starting on stdio transport".to_string());
    let server = McpServer::new();
    server.serve(rmcp::transport::stdio()).await?.waiting().await?;
    Ok(())
}

async fn run_http() -> Result<(), Box<dyn std::error::Error>> {
    use rmcp::transport::streamable_http_server::{
        session::local::LocalSessionManager, StreamableHttpServerConfig, StreamableHttpService,
    };
    use std::sync::Arc;

    let port = match resolve_port("mcp", START_PORT, END_PORT) {
        Some(p) => p,
        None => {
            Logger::error(format!("No available port in range {}-{}", START_PORT, END_PORT));
            std::process::exit(1);
        }
    };

    std::thread::spawn(move || register_mcp_server(port));

    let service = StreamableHttpService::new(
        || Ok(McpServer::new()),
        Arc::new(LocalSessionManager::default()),
        StreamableHttpServerConfig::default(),
    );
    let router = axum::Router::new().nest_service("/mcp", service);
    let addr = format!("0.0.0.0:{}", port);
    println!("MCP server listening on http://{}/mcp", addr);
    Logger::info(format!("MCP server (streamable-http) listening on http://{}/mcp", addr));

    let listener = tokio::net::TcpListener::bind(&addr).await?;
    axum::serve(listener, router).await?;
    Ok(())
}

fn find_port(start: u16, end: u16) -> Option<u16> {
    (start..=end).find(|&p| std::net::TcpListener::bind(("0.0.0.0", p)).is_ok())
}

/// Same fixed-port-with-fallback resolution as the API/Scheduler/ScriptAgent
/// servers -- see their main.generated.rs.cshtml for the full rationale.
fn resolve_port(service: &str, default_start: u16, default_end: u16) -> Option<u16> {
    match Config::server_port(service) {
        Some(configured) => {
            if std::net::TcpListener::bind(("0.0.0.0", configured)).is_ok() {
                Some(configured)
            } else {
                Logger::warning(format!(
                    "{}: configured port {} (servers.{}.port in ~/.@(Model.Name).json) is already \
                     in use -- scanning forward for a free port instead.",
                    service, configured, service
                ));
                let scan_width = default_end.saturating_sub(default_start);
                find_port(configured, configured.saturating_add(scan_width))
                    .or_else(|| find_port(default_start, default_end))
            }
        }
        None => find_port(default_start, default_end),
    }
}

fn init_logging() {
    if let Ok(level) = std::env::var("JUMPSTART_LOG") {
        let level = match level.trim().to_ascii_lowercase().as_str() {
            "debug" => LogLevel::Debug,
            "warning" | "warn" => LogLevel::Warning,
            "error" => LogLevel::Error,
            _ => LogLevel::Info,
        };
        Logger::set_level(level);
        Logger::info(format!("log level set to {:?} from JUMPSTART_LOG", level));
    }
    logic::register_db_log_writer();
}

/// Register this running MCP server as a `core.server_node` row, mirroring
/// the API server's `register_api_server` (see its main.generated.rs.cshtml).
/// Only called for the http transport -- a stdio instance is an ephemeral,
/// client-launched process with no listening address worth advertising to
/// other nodes. Uses the unchecked logic path for the same reason the API
/// server's self-registration does: there is no request principal yet at
/// startup, since the server is acting on its own behalf.
fn register_mcp_server(port: u16) {
    Util::populate_session_info();

    let computer_name = SessionInfo::get_value("ComputerName", Some("unknown")).unwrap_or_default();
    let ip_address = "0.0.0.0".to_string();
    let url = format!("http://{}:{}/mcp", computer_name, port);
    let username = SessionInfo::get_value("UserName", Some("")).unwrap_or_default();
    let user_domain = SessionInfo::get_value("UserDomain", Some("")).unwrap_or_default();
    let os_name = SessionInfo::get_value("OSName", Some("")).unwrap_or_default();
    let os_version = SessionInfo::get_value("OSVersion", Some("")).unwrap_or_default();
    let architecture = SessionInfo::get_value("Architecture", Some("")).unwrap_or_default();

    println!("==============================================");
    println!("MCP Server Registration");
    println!("==============================================");
    println!("MCP Server ID: {}:{}", computer_name, port);
    println!("URL:           {}", url);
    println!("==============================================");

    let mut record = BaseObject::new();
    record.set("hostname", serde_json::json!(computer_name));
    record.set("server_node_type_id", serde_json::json!(ServerNodeType::McpServer as i64));
    record.set("ip_address", serde_json::json!(ip_address));
    record.set("port", serde_json::json!(port));
    record.set("url", serde_json::json!(url));
    record.set("username", serde_json::json!(username));
    record.set("user_domain", serde_json::json!(user_domain));
    record.set("os_name", serde_json::json!(os_name));
    record.set("os_version", serde_json::json!(os_version));
    record.set("architecture", serde_json::json!(architecture));
    record.set("registered_at", serde_json::json!(Util::now_timestamp()));
    record.set("server_node_status_id", serde_json::json!(ServerNodeStatus::Online as i64));
    record.set("is_active", serde_json::json!(1));
    record.set("created_by", serde_json::json!(username));

    let mut ctx = LogicContext::for_record(record);
    match ServerNodeLogic::exec_unchecked("put", &mut ctx) {
        Ok(_) => {
            let id = ctx.transaction.get("id").as_i64().unwrap_or_default();
            Logger::info(format!("MCP server registered as ServerNode id {} ({})", id, url));
        }
        Err(e) => Logger::error(format!("MCP server registration failed: {}", e)),
    }
}
