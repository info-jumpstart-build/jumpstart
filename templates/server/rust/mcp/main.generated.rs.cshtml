/// The principal `call_tool` resolved for this call (see `resolve_principal`),
/// threaded into every tool method via the `Extension` extractor so it can
/// hand it to `run_on_db_thread`. Always present -- `call_tool` inserts it
/// for every call, both transports alike -- so extracting it never fails.
#[derive(Debug, Clone)]
struct ResolvedPrincipal(Option<String>);

type DbJob = Box<dyn FnOnce() + Send>;

fn db_worker() -> &'static std::sync::mpsc::Sender<DbJob> {
    static SENDER: OnceLock<std::sync::mpsc::Sender<DbJob>> = OnceLock::new();
    SENDER.get_or_init(|| {
        let (tx, rx) = std::sync::mpsc::channel::<DbJob>();
        std::thread::spawn(move || {
            for job in rx {
                job();
            }
        });
        tx
    })
}

/// Run a synchronous logic-layer call on the dedicated db-worker thread with
/// `principal` set as the current user for its duration, and await the
/// result. See the module doc comment above for why this exists; use it for
/// *any* logic-layer call a tool body makes, generated or hand-written.
async fn run_on_db_thread<F, T>(principal: Option<String>, work: F) -> Result<T, McpError>
where
    F: FnOnce() -> Result<T, McpError> + Send + 'static,
    T: Send + 'static,
{
    let (tx, rx) = tokio::sync::oneshot::channel::<Result<T, McpError>>();
    let job: DbJob = Box::new(move || {
        OpRoleMemberLogic::set_current_user(principal.as_deref());
        let result = work();
        OpRoleMemberLogic::set_current_user(None);
        let _ = tx.send(result);
    });
    if db_worker().send(job).is_err() {
        return Err(McpError::internal_error("mcp db worker unavailable", None));
    }
    rx.await
        .unwrap_or_else(|_| Err(McpError::internal_error("mcp db worker dropped the response", None)))
}

