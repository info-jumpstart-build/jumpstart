# <auto-generated> MCP (Model Context Protocol) server for @Model.Name. </auto-generated>
[package]
name = "mcp"
version = "0.1.0"
edition = "2021"
description = "MCP server for @Model.Name (generated by Jumpstart)"

[[bin]]
name = "mcp"
path = "main.generated.rs"

[dependencies]
common = { path = "../../shared/common" }
domain = { path = "../../shared/domain" }
logic = { path = "../../shared/logic" }
persist = { path = "../../shared/persist" }
serde = { version = "1", features = ["derive"] }
serde_json = "1"
schemars = "1"
# Parsing decimal/DateTime/Guid tool-argument strings back into the Rust type
# a domain object's typed setter expects (see toDomainExpr in main.generated.rs) --
# same versions the domain crate itself depends on.
chrono = { version = "0.4", features = ["serde"] }
rust_decimal = "1"
uuid = { version = "1", features = ["serde", "v4"] }
# One tool per entity per CRUD verb (list/get/create/update/delete), registered
# via rmcp's #[tool_router]/#[tool] macros -- see main.generated.rs for why.
rmcp = { version = "3", features = ["server", "transport-io", "transport-streamable-http-server", "macros", "schemars"] }
# rmcp is async; this is the first async binary in the Rust stack (api/scheduler/
# scriptagent are synchronous, thread-per-request via rouille).
tokio = { version = "1", features = ["rt-multi-thread", "macros", "net", "io-std", "io-util", "signal", "sync"] }
# Streamable-HTTP/SSE transport is served as a normal axum route (see
# docs/rust/mcp-server.md); stdio does not need it but shares this Cargo.toml.
axum = "0.8"
http = "1"
