@@page "/@(Model.DomainVar)"
@@using System.Collections.Generic;
@@using @(Model.Namespace).Components;
@@inject HttpClient Http
@@inject IHttpClientFactory ClientFactory
@@inject NavigationManager Navigation
@@inject IJSRuntime JS
@@implements IAsyncDisposable
@@rendermode @@(new InteractiveWebAssemblyRenderMode(prerender: false))
@using jumpstart;


<PageTitle>@(Model.Label)</PageTitle>

<h1>@(Model.Label)</h1>

<p>This component demonstrates fetching @(Model.Label) data from the server.</p>

@@if (@(Model.DomainVar)List == null)
{
    <p><em>Loading...</em></p>
}
else
{
    Console.WriteLine($"ListTemplate: About to render DataTable with {@@@(Model.DomainVar)List.Length} items");
 
    
    <DataTable Data="&at;@(Model.DomainVar)List" 
               DataType="typeof(@(Model.DomainObj)View)" 
               ShowActions="true" 
               ShowAddButton="true"
               OnEdit="&at;OnEdit@(Model.DomainObj)"
               OnAdd="&at;OnAdd@(Model.DomainObj)" />
    
    Console.WriteLine($"ListTemplate: DataTable rendered");
}

@@code {
    protected  @(Model.DomainObj)View[]? @(Model.DomainVar)List;
    // Real-time updates arrive over Server-Sent Events (see wwwroot/js/notifications.js).
    private IJSObjectReference? _sseHandle;
    private IDisposable? _sseRef;
    private string _domainObjectName = "@(Model.DomainObj)";
    private Dictionary<string, Dictionary<long, string>> enumData = new Dictionary<string, Dictionary<long, string>>();

    protected override async Task OnInitializedAsync()
    {
        var remoteClient = ClientFactory.CreateClient("RemoteAPI");

        @(Model.DomainVar)List = await remoteClient.GetFromJsonAsync<@(Model.DomainObj)View[]>("api/@(Model.DomainVar)");
        
        Console.WriteLine($"ListTemplate: Loaded {@(Model.DomainVar)List?.Length ?? 0} @(Model.DomainVar) records");
        if (@(Model.DomainVar)List != null && @(Model.DomainVar)List.Length > 0)
        {
            Console.WriteLine($"ListTemplate: First item type: {@(Model.DomainVar)List[0].GetType().Name}");
        }

        await ConnectNotifications();
        await InitEnumData();
    }

    // Open the SSE notification stream. The browser's EventSource (via the JS
    // interop) handles reconnection on its own. Every "PropertyUpdated" event is
    // routed back to OnPropertyUpdated below.
    //
    // The browser's native EventSource can't attach an Authorization header,
    // so it can't reuse the bearer token "RemoteAPI" normally attaches --
    // instead a short-lived, single-use ticket is minted first over a normal
    // (authenticated) POST, then passed as `?ticket=` on the stream URL. See
    // the API server's stream-ticket handler (NotificationController) for the
    // full rationale.
    private async Task ConnectNotifications()
    {
        try
        {
            var remoteClient = ClientFactory.CreateClient("RemoteAPI");
            var baseAddress = remoteClient.BaseAddress?.ToString() ?? "http://localhost:5200";

            var ticketResponse = await remoteClient.PostAsJsonAsync("api/Notification/stream-ticket", new { });
            ticketResponse.EnsureSuccessStatusCode();
            var ticket = await ticketResponse.Content.ReadFromJsonAsync<StreamTicketResponse>();

            var streamUrl = $"{baseAddress.TrimEnd('/')}/api/Notification/stream?ticket={Uri.EscapeDataString(ticket?.Ticket ?? string.Empty)}";

            _sseRef = DotNetObjectReference.Create(this);
            _sseHandle = await JS.InvokeAsync<IJSObjectReference>("jumpstartSse.connect", streamUrl, _sseRef);
            Console.WriteLine($"ListTemplate: SSE notification stream connected for {_domainObjectName}");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ListTemplate: Error connecting notification stream: {ex.Message}");
        }
    }

    // Response shape for POST api/Notification/stream-ticket (mirrors the
    // API server's StreamTicketResponse). ReadFromJsonAsync defaults to
    // case-insensitive, camelCase-aware deserialization, so this matches the
    // server's `{ "ticket": "..." }` without needing a [JsonPropertyName].
    private class StreamTicketResponse
    {
        public string Ticket { get; set; }
    }

    // Invoked from JS for every "PropertyUpdated" SSE event. Filters to this
    // page's domain object, then updates the affected row in place.
    [JSInvokable]
    public async Task OnPropertyUpdated(string json)
    {
        try
        {
            var message = System.Text.Json.JsonSerializer.Deserialize<PropertyUpdateMessage>(
                json,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (message != null && message.DomainObjectName == _domainObjectName)
            {
                Console.WriteLine($"ListTemplate: Received update for {message.DomainObjectName}[{message.InstanceId}]");
                await HandlePropertyUpdate(message);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ListTemplate: Error handling notification: {ex.Message}");
        }
    }

    private async Task InitEnumData()
    {
        var remoteClient = ClientFactory.CreateClient("RemoteAPI");
        @{
            foreach (var enumAttribute in Model.EnumAttributes)
            {
                var enumObjectDomainVar = enumAttribute.EnumAttribute.FkObject.ToLower();
                var enumIdColumn = enumAttribute.idColumn;
           
            <text>
                var enum@(enumIdColumn)Result = await remoteClient.GetFromJsonAsync&lt;List&lt;EnumHelper&gt;&gt;($"api/@((enumObjectDomainVar).ToLower())/enum");
                if (enum@(enumIdColumn)Result != null)
                {
                    enumData["@(enumIdColumn)"] = enum@(enumIdColumn)Result.ToDictionary(e => e.id, e => e.rwkString);
                }
             </text>
                
            }
        }
    }

    private async Task HandlePropertyUpdate(PropertyUpdateMessage message)
    {
        try
        {
            if (@(Model.DomainVar)List == null)
            {
                return;
            }

            // Find the item in the list by ID
            var index = Array.FindIndex(@(Model.DomainVar)List, item => item.id == message.InstanceId);
            
            if (index >= 0)
            {
                // Fetch the updated item from the API to ensure we have the complete View object
                // with all computed properties and enum display values properly populated
                var remoteClient = ClientFactory.CreateClient("RemoteAPI");
                var updatedObject = await remoteClient.GetFromJsonAsync<@(Model.DomainObj)View>($"api/@(Model.DomainVar)/view/{message.InstanceId}");
                if (updatedObject != null)
                { 
                @{
                    foreach( var enumAttribute in Model.EnumAttributes)
                    {
                        <text>
                        //if (enumData.ContainsKey("@(enumAttribute.idColumn)") && enumData["@(enumAttribute.idColumn)"].ContainsKey(updatedObject.@(enumAttribute.idColumn)))
                        //updatedObject.@(enumAttribute.nameColumn) = enumData["@(enumAttribute.idColumn)"][updatedObject.@(enumAttribute.idColumn)];
                        </text>
                    }
                }

               
                    // Update existing item with the fetched object (enum display values are already set by the API)
                    @(Model.DomainVar)List[index] = updatedObject;
                    Console.WriteLine($"ListTemplate: Updated {_domainObjectName}[{message.InstanceId}] in list from API");
                    
                    // Notify UI to update
                    await InvokeAsync(StateHasChanged);
                }
            }
            else
            {
                // Item not found, might be a new item - reload the list
                Console.WriteLine($"ListTemplate: {_domainObjectName}[{message.InstanceId}] not found in list, reloading...");
                await ReloadList();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ListTemplate: Error handling property update: {ex.Message}");
            // On error, fall back to reloading the entire list
            try
            {
                await ReloadList();
            }
            catch (Exception reloadEx)
            {
                Console.WriteLine($"ListTemplate: Error reloading list: {reloadEx.Message}");
            }
        }
    }

    private async Task ReloadList()
    {
        try
        {
            var remoteClient = ClientFactory.CreateClient("RemoteAPI");
            @(Model.DomainVar)List = await remoteClient.GetFromJsonAsync<@(Model.DomainObj)View[]>("api/@(Model.DomainVar)");
            Console.WriteLine($"ListTemplate: Reloaded {@(Model.DomainVar)List?.Length ?? 0} @(Model.DomainVar) records");
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ListTemplate: Error reloading list: {ex.Message}");
        }
    }

    async Task OnAdd@(Model.DomainObj)()
    {
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        Navigation.NavigateTo($"edit-@(Model.DomainVar)?returnUrl={Uri.EscapeDataString(currentPath)}");
    }

    async Task OnEdit@(Model.DomainObj)(object item)
    {
        var @(Model.DomainVar) = (@(Model.DomainObj)View)item;
        var currentPath = new Uri(Navigation.Uri).AbsolutePath;
        Navigation.NavigateTo($"edit-@(Model.DomainVar)/{@(Model.DomainVar).id}?returnUrl={Uri.EscapeDataString(currentPath)}");
    }

    public async ValueTask DisposeAsync()
    {
        if (_sseHandle is not null)
        {
            try
            {
                await _sseHandle.InvokeVoidAsync("close");
                await _sseHandle.DisposeAsync();
                Console.WriteLine($"ListTemplate: SSE notification stream closed");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"ListTemplate: Error closing notification stream: {ex.Message}");
            }
        }
        _sseRef?.Dispose();
    }

    // Message structure for property update notifications (matches server-side PropertyUpdateMessage)
    private class PropertyUpdateMessage
    {
        public string DomainObjectName { get; set; } = string.Empty;
        public long InstanceId { get; set; }
        public string JsonData { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
    }
}
